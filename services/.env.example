# Másold .env néven (a docker-compose.yml mellé), és töltsd ki. A .env ne kerüljön a gitbe.

POSTGRES_PASSWORD=erős-véletlen-jelszó

# Közös titok a WordPress bővítménnyel (wp-config.php: HPV_SEO_OS_SECRET) – legalább 32 karakter.
#   előállítás: openssl rand -hex 32
SEO_OS_HMAC_SECRET=

# A Screaming Frog ügynök tokenje (az ügynök agent.env-jében ugyanez: HPV_AGENT_TOKEN).
SEO_OS_AGENT_TOKEN=

# API kulcsok – megadhatók itt, vagy később a felületen (Beállítások → Integrációk); a felületi érték az erősebb.
SEO_OS_OPENAI_API_KEY=
SEO_OS_ANTHROPIC_API_KEY=
SEO_OS_DATAFORSEO_LOGIN=
SEO_OS_DATAFORSEO_PASSWORD=
SEO_OS_AHREFS_API_KEY=

# Csak ha a Screaming Frog a szerveren fut (docker compose --profile crawler):
HPV_SEO_URL=https://seo.helloprovision.com
SF_VERSION=22.0
SF_LICENCE_USER=
SF_LICENCE_KEY=
SF_EULA=
SF_MEMORY=4g
